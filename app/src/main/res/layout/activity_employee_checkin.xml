<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen_alt"
    android:paddingHorizontal="24dp">

    <!-- Header thông tin nhân viên -->
    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:letterSpacing="0.04"
        android:text="@string/employee_header"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvEmployeeWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/employee_welcome_prefix"
        android:textColor="@color/text_heading"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        tools:text="Xin chào, Trần Thị B" />

    <!-- Trạng thái đã / chưa chấm công hôm hôm nay -->
    <LinearLayout
        android:id="@+id/layoutTodayStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_status_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEmployeeWelcome">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_status_success" />

        <TextView
            android:id="@+id/tvTodayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/employee_status_not_checked_in"
            android:textColor="@color/status_success"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Card chứa mã Dynamic QR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardQr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTodayStatus"
        app:layout_constraintWidth_max="280dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/employee_qr_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="@string/employee_qr_subtitle"
                android:textColor="@color/text_muted_light"
                android:textSize="10sp" />

            <!-- Khung chứa QR -->
            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:background="@color/bg_qr_placeholder">

                <ImageView
                    android:id="@+id/imgDynamicQR"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/cd_qr_code"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher_foreground" />

                <ProgressBar
                    android:id="@+id/progressQrLoading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvQrError"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#CCFFFFFF"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Không tải được mã QR.\nKiểm tra kết nối mạng."
                    android:textColor="@color/status_error"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="gone" />
            </FrameLayout>

            <!-- Thanh đếm ngược thời gian làm mới QR -->
            <ProgressBar
                android:id="@+id/progressQRTimer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="75"
                android:progressTint="@color/brand_primary" />

            <TextView
                android:id="@+id/tvTimerCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:text="Mã làm mới sau: 08s" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Phương án chấm công dự phòng -->
    <LinearLayout
        android:id="@+id/layoutFallbackActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardQr">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanPortalQR"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/brand_primary"
            android:text="@string/employee_btn_scan_gate"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanRfid"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/employee_btn_scan_rfid"
            android:textAllCaps="false"
            android:textColor="@color/brand_primary"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            app:strokeColor="@color/brand_primary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>