<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quyền mạng: cần khi kết nối backend thật và Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppChamCong"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- MÀN HÌNH KHỞI CHẠY ĐẦU TIÊN (LoginActivity) -->
        <activity
            android:name=".login.activity_login"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình Đăng ký tài khoản nhân viên -->
        <activity
            android:name=".login.activity_register"
            android:exported="false" />

        <!-- Mành hình dành cho Nhân viên -->
        <activity
            android:name=".employee.EmployeeCheckInActivity"
            android:exported="false" />

        <!-- Màn hình dành cho Quản lý (Admin) -->
        <activity
            android:name=".admin.AdminAttendanceActivity"
            android:exported="false" />

    </application>
</manifest>